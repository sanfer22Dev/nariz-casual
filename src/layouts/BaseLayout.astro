---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Reseñas reales de perfumes: reviews, comparativas y rankings útiles.'
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://narizcasual.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const navLinks = [
	{ href: '/', label: 'Inicio' },
	{ href: '/reviews', label: 'Reviews' },
	{ href: '/comparativas', label: 'Comparativas' },
	{ href: '/rankings', label: 'Rankings' },
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/contacto', label: 'Contacto' }
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" type="application/xml" href="https://narizcasual.com/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Nariz Casual" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<div class="container nav">
				<a class="logo" href="/">Nariz Casual</a>
				<nav aria-label="Principal">
					<ul>
						{navLinks.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main class="container">
			<slot />
		</main>

		<footer>
			<div class="container footer-content">
				<p>© {new Date().getFullYear()} Nariz Casual</p>
				<a href="/politica-de-privacidad">Política de privacidad</a>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
		margin: 0;
		line-height: 1.6;
		color: #161616;
		background: #ffffff;
	}

	:global(a) {
		color: inherit;
	}

	:global(h1),
	:global(h2),
	:global(h3) {
		line-height: 1.2;
	}

	:global(section) {
		margin-block: 2rem;
	}

	:global(.card-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	:global(.card) {
		border: 1px solid #e8e8e8;
		border-radius: 0.75rem;
		padding: 1rem;
	}

	:global(.muted) {
		color: #666;
	}

	.container {
		width: min(1080px, 92%);
		margin-inline: auto;
	}

	header {
		border-bottom: 1px solid #efefef;
	}

	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1rem 0;
	}

	.logo {
		font-weight: 700;
		text-decoration: none;
	}

	nav ul {
		display: flex;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}

	nav a {
		text-decoration: none;
	}

	main {
		padding: 2rem 0 3rem;
	}

	footer {
		border-top: 1px solid #efefef;
		padding: 1rem 0;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
</style>