---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const comparativas = (await getCollection('comparativas')).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<BaseLayout
	title="Comparativas | Nariz Casual"
	description="Comparativas de perfumes para elegir según tu estilo y uso."
>
	<h1>Comparativas</h1>
	<div class="card-grid">
		{comparativas.map((entry) => (
			<article class="card">
				<h2><a href={`/comparativas/${entry.data.slug}/`}>{entry.data.title}</a></h2>
				<p class="muted">{entry.data.description}</p>
			</article>
		))}
	</div>
</BaseLayout>