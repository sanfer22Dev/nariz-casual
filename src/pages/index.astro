---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const reviews = (await getCollection('reviews'))
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 3);

const articulos = (await getCollection('articulos'))
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 3);
---

<BaseLayout
	title="Nariz Casual | Reviews reales de perfumes"
	description="Web de contenido sobre perfumes con reviews reales y útiles."
>
	<section>
		<h1>Reseñas reales de perfumes, sin humo</h1>
		<p class="muted">Reviews honestas para ayudarte a elegir mejor.</p>
		<p>
			<a href="/reviews">Ver reviews</a> · <a href="/articulos">Ver artículos</a>
		</p>
	</section>

	<section>
		<h2>Búsqueda rápida</h2>
		<form action="/buscar" method="get" class="search-form">
			<input
				type="search"
				name="q"
				placeholder="Busca en todo el sitio..."
				aria-label="Buscar en todo el sitio"
				required
			/>
			<button type="submit">Buscar</button>
		</form>
	</section>

	<section>
		<div class="section-header">
			<h2>Últimas reseñas</h2>
			<a class="secondary-link" href="/reviews">Ver todas</a>
		</div>
		<div class="card-grid">
			{reviews.map((entry) => (
				<article class="card">
					<h3><a href={`/reviews/${entry.data.slug}/`}>{entry.data.nombre}</a></h3>
					<p class="muted">{entry.data.marca} · {entry.data.tipo}</p>
					<p>Puntuación: {entry.data.puntuacion}/10</p>
				</article>
			))}
		</div>
	</section>

	<section>
		<div class="section-header">
			<h2>Últimos artículos</h2>
			<a class="secondary-link" href="/articulos">Ver todos</a>
		</div>
		<div class="card-grid">
			{articulos.map((entry) => (
				<article class="card">
					<h3><a href={`/articulos/${entry.data.slug}/`}>{entry.data.title}</a></h3>
					<p class="muted">{entry.data.description}</p>
				</article>
			))}
		</div>
	</section>

</BaseLayout>

<style>
	.search-form {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.search-form input {
		flex: 1 1 280px;
		padding: 0.65rem 0.75rem;
		border: 1px solid #ddd;
		border-radius: 0.5rem;
	}

	.search-form button {
		padding: 0.65rem 1rem;
		border: 1px solid #1d1d1d;
		border-radius: 0.5rem;
		background: #1d1d1d;
		color: #fff;
		cursor: pointer;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.secondary-link {
		display: inline-block;
		padding: 0.45rem 0.8rem;
		border: 1px solid #1d1d1d;
		border-radius: 0.45rem;
		text-decoration: none;
		font-weight: 600;
	}
</style>
